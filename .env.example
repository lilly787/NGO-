DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/gsei"
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD_HASH=""
ADMIN_SESSION_SECRET="use-a-long-random-secret"

# Cloudinary image uploads (create a free account at cloudinary.com)
# NEXT_PUBLIC_ prefix required — these are used in the browser to upload directly to Cloudinary
# Create an *unsigned* upload preset in Cloudinary Settings > Upload > Upload presets
# Never put your Cloudinary API Secret here.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=""
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=""
